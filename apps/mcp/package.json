{
  "name": "@tc39-atlas/mcp",
  "version": "1.0.0",
  "description": "Local read-only MCP server for the TC39 Atlas proposal dataset",
  "type": "module",
  "bin": {
    "tc39-atlas-mcp": "dist/index.mjs"
  },
  "main": "./dist/index.mjs",
  "exports": "./dist/index.mjs",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bosens-China/tc39-atlas.git",
    "directory": "apps/mcp"
  },
  "homepage": "https://bosens-china.github.io/tc39-atlas/",
  "bugs": "https://github.com/bosens-China/tc39-atlas/issues",
  "keywords": [
    "mcp",
    "tc39",
    "ecmascript",
    "javascript"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown && tsx scripts/copy-dataset.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@tc39-atlas/core": "workspace:*",
    "@types/node": "^26.1.2",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.9",
    "typescript": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
