# GitHub Actions 中配置为 Secret；不要提交真实值
DEEPSEEK_API_KEY=

# 默认使用 https://api.deepseek.com、deepseek-v4-flash 和温度 1.0
# TRANSLATION_BASE_URL=https://api.deepseek.com
# TRANSLATION_MODEL=deepseek-v4-flash
# 可选；仅在目标模型需要显式限制输出时设置
# TRANSLATION_MAX_OUTPUT_TOKENS=65536
# 每篇提案独立请求；默认同时处理 100 篇
TRANSLATION_CONCURRENCY=100
# TRANSLATION_MAX_ITEMS=10

# 数据生成
# PREVIOUS_DATASET_URL=https://bosens-china.github.io/tc39-atlas/data/dataset.json
# DATASET_OUTPUT_DIR=apps/web/docs/public/data
